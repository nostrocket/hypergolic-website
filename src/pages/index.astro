---
import '../styles/site.css';

const repository = 'https://github.com/nostrocket/hypergolic';
const releases = `${repository}/releases`;
const version = '0.2.0';
const releaseNotes = `${releases}/tag/v${version}`;
const androidApk = `${releases}/download/v${version}/hypergolic-${version}-2-arm64.apk`;
const title = 'Hypergolic — A native home for Nostr napplets';
const description = 'Discover Nostr napplets, pin favorites to Home, and switch between open apps on Android. Bring your Nostr identity and choose how you sign.';
const canonical = new URL('/', Astro.site).href;
const socialImage = new URL('/assets/social-preview.jpg', Astro.site).href;
const steps = [
  ['Discover', 'Browse published apps and signed recommendations from other Nostr users.'],
  ['Review access', 'See who published the napplet and what it asks to use.'],
  ['Open in your workspace', 'Switch between apps in Overview. Pin favorites to Home for the identity you’re using.'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090d13" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon.png" />
    <link rel="preload" href="/assets/fonts/barlow-light.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hypergolic" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Hypergolic spark above a long exposure of a launch at night. Nostr, beyond the feed." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body id="top">
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="Hypergolic home">
        <img src="/assets/spark-64.png" srcset="/assets/spark-128.png 2x" width="64" height="64" alt="" />
        Hypergolic
      </a>
      <nav aria-label="Main navigation">
        <a class="nav-inside" href="#inside">Inside the app</a>
        <a href={repository}>GitHub <span class="outbound" aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <section class="opening" aria-labelledby="headline">
        <picture class="horizon" aria-hidden="true">
          <source media="(max-width: 600px)" srcset="/assets/launch-portrait-480.webp 480w, /assets/launch-portrait-780.webp 780w" sizes="100vw" />
          <source media="(max-width: 1000px)" srcset="/assets/launch-tablet-1200.webp" />
          <img src="/assets/launch-wide-1600.webp" srcset="/assets/launch-wide-960.webp 960w, /assets/launch-wide-1600.webp 1600w" sizes="100vw" width="1600" height="750" alt="" fetchpriority="high" />
        </picture>
        <div class="hero-content">
          <h1 id="headline">Nostr, beyond<br />the feed.</h1>
          <p class="hero-description">Find and open napplets in one workspace. Bring your Nostr identity and choose how you sign.</p>
          <div class="download">
            <a class="download-button" href={androidApk}>Download for Android <span class="download-arrow" aria-hidden="true">↓</span></a>
            <div class="release-details">
              <span class="format">ARM64 APK</span>
              <a href={releaseNotes}>v{version} release notes</a>
            </div>
          </div>
        </div>
      </section>
      <section class="discover section-width" id="inside" aria-labelledby="discover-title">
        <div class="discover-heading">
          <p class="eyebrow">Inside Hypergolic</p>
          <h2 id="discover-title">Find your next napplet.</h2>
        </div>
        <p class="discover-intro">Find a paper-pattern tool or a game of rocket car soccer in Discover. Hypergolic remembers the touch controls you choose for each game.</p>
        <ol class="steps">
          {steps.map(([label, detail]) => (
            <li>
              <h3>{label}</h3>
              <p>{detail}</p>
            </li>
          ))}
        </ol>
        <figure class="phone">
          <div class="phone-frame">
            <img
              src="/assets/discover-dark-540.webp"
              srcset="/assets/discover-dark-540.webp 540w, /assets/discover-dark-1080.webp 1080w"
              sizes="(max-width: 600px) 80vw, (max-width: 1000px) 33vw, (max-width: 1700px) 26vw, 440px"
              width="1080" height="2400" loading="lazy" decoding="async"
              alt="Discover in Hypergolic. Published napplets include Nappakura for paper patterns and Boost Ball for rocket car soccer, each with an Open button."
            />
          </div>
          <figcaption>Discover on Android · v0.1.0</figcaption>
        </figure>
      </section>
      <section class="signing section-width" aria-labelledby="signing-title">
        <h2 id="signing-title">Choose how you sign.</h2>
        <div>
          <p>Use a local key, connect a remote signer, or bring an Android signer like Amber. Hypergolic shows you the event before you approve it. Napplets never receive your private key.</p>
          <a class="text-link" href={`${repository}/blob/main/docs/signing-core.md`}>How signing works <span class="outbound" aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>

    <footer class="footer section-width">
      <a class="wordmark" href="#top" aria-label="Hypergolic home">
        <img src="/assets/spark-64.png" width="64" height="64" alt="" />
        Hypergolic
      </a>
      <nav aria-label="Project resources">
        <a href={releases}>Releases</a>
        <a href={`${repository}/issues`}>Support</a>
        <a href={`${repository}/blob/main/docs/privacy.md`}>App privacy</a>
        <a href={repository}>GitHub <span class="outbound" aria-hidden="true">↗</span></a>
      </nav>
    </footer>
  </body>
</html>
