---
import { capabilities } from '../data/capabilities';
import { referenceSample } from '../explorer/compatibility.js';

const supported = capabilities.filter(({ status }) => status === 'full' || status === 'partial').map(({ domain }) => domain);
const { matched, total, relays, observedAt } = referenceSample;
const percent = Math.round(100 * matched / total);
const observed = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'UTC', timeZoneName: 'short',
}).format(observedAt * 1000);
---

<div class="page-intro compatibility-hero" data-compatibility-hero data-supported-domains={supported.join(' ')}>
  <div class="hero-intro">
    <p class="release">Hypergolic v0.2.0</p>
    <h1>Capability table</h1>
    <p class="summary">See which capabilities napplets can use in Hypergolic and what remains to implement or test.</p>
  </div>
  <section class="metric" aria-labelledby="compatibility-label">
    <h2 id="compatibility-label">Estimated compatibility</h2>
    <p class="value"><span data-percent>{percent}</span><span data-percent-sign>%</span></p>
    <p class="population" data-population>{matched} of {total} sampled napplets match on required capabilities.</p>
    <p class="observation" data-observation>Historical sample · {relays} relays · {observed}</p>
    <details class="method">
      <summary>How it’s counted</summary>
      <p>Each eligible root or named publication counts once. A napplet matches when every required domain in its signed manifest has Full or Partial support in Hypergolic v0.2.0. A napplet with no required domains also matches. Optional domains have no effect on the count.</p>
      <p>Partial support may omit an operation a napplet needs. The estimate covers publications observed on the sampled relays. <a href="/explorer/">Inspect the publications and relay coverage.</a></p>
    </details>
  </section>
</div>

<script>
  import { mountCompatibilityHero } from '../explorer/compatibility-hero.js';
  const hero = document.querySelector<HTMLElement>('[data-compatibility-hero]');
  if (hero) mountCompatibilityHero(hero);
</script>

<style>
  :global(.reference-hero:has(.compatibility-hero)) {
    padding-bottom: clamp(3.5rem, 5vw, 5rem);
  }
  :global(.reference-hero:has(.compatibility-hero) .launch-backdrop::after) {
    background: linear-gradient(90deg, rgb(7 13 23 / 75%), rgb(7 13 23 / 51%) 48%, rgb(7 13 23 / 16%) 79%),
      linear-gradient(0deg, rgb(7 13 23 / 31%), transparent 35%);
  }
  .compatibility-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, .88fr);
    align-items: center;
    gap: clamp(2.5rem, 5.5vw, 6rem);
    padding-top: clamp(2.25rem, 3.1vw, 3.25rem);
  }
  .release { font: .88rem/1.4 var(--mono); letter-spacing: .02em; color: var(--accent); margin-bottom: .92rem; }
  .hero-intro h1 { font-size: clamp(3.1rem, 6.1vw, 6.25rem); line-height: .99; letter-spacing: -.035em; margin: 0; }
  .summary { max-width: 43ch; margin-top: .95rem; font-size: clamp(1.075rem, 1.49vw, 1.34rem); line-height: 1.43; }
  .metric { max-width: 31rem; padding-left: clamp(1.5rem, 2.8vw, 3rem); border-left: 1px solid rgb(233 237 238 / 35%); }
  .metric h2 { font: .81rem/1.3 var(--mono); letter-spacing: .065em; text-transform: uppercase; }
  .value { display: flex; align-items: baseline; gap: .03em; font-size: clamp(4.6rem, 6.65vw, 6.8rem); font-weight: 300; line-height: .99; letter-spacing: -.045em; margin: .14rem 0 .26rem; }
  [data-percent-sign] { font-size: .51em; letter-spacing: -.035em; color: var(--accent); }
  .population { font-size: 1.05rem; line-height: 1.4; }
  .observation { text-wrap: pretty; font: .8rem/1.5 var(--mono); color: var(--muted); margin: .28rem 0 .35rem; }
  .method { font-size: 1rem; line-height: 1.5; }
  .method summary, .method a { color: var(--accent); text-decoration: underline; text-underline-offset: .24em; }
  .method summary { display: inline-flex; align-items: center; min-height: 44px; cursor: pointer; }
  .method summary::-webkit-details-marker { display: none; }
  .method p { margin-top: .5rem; }
  .method :is(a, summary):focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media (max-width: 700px) {
    :global(.reference-hero:has(.compatibility-hero)) { padding-bottom: 2.5rem; }
    :global(.reference-hero:has(.compatibility-hero) .launch-backdrop::after) {
      background: linear-gradient(90deg, rgb(7 13 23 / 86%), rgb(7 13 23 / 63%) 62%, rgb(7 13 23 / 10%));
    }
    .compatibility-hero { grid-template-columns: 1fr; justify-items: start; align-items: start; gap: 1.55rem; padding-top: 1.5rem; }
    .release { font-size: .81rem; margin-bottom: .55rem; }
    .hero-intro h1 { font-size: clamp(2.9rem, 10.7vw, 4.6rem); }
    .summary { font-size: 1.05rem; max-width: 36ch; margin-top: .65rem; }
    .metric { border-left: 0; border-top: 1px solid rgb(233 237 238 / 30%); padding: .87rem 0 0; max-width: 100%; width: 100%; }
    .metric h2 { font-size: .76rem; }
    .value { font-size: 4.2rem; margin: .1rem 0; }
    .population { font-size: 1rem; }
    .observation { font-size: .76rem; margin: .2rem 0 .2rem; }
  }
</style>
